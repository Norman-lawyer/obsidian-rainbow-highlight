{
  "name": "obsidian-rainbow-highlight",
  "version": "1.1.3",
  "description": "Beautiful multi-color text highlighting for Obsidian",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node --import tsx --test tests/*.test.mjs",
    "test:coverage": "node --experimental-test-coverage --import tsx --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^16.11.6",
    "builtin-modules": "3.3.0",
    "esbuild": "0.17.3",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "tsx": "^4.23.15",
    "typescript": "4.7.4"
  }
}
